# Secrets remain only in .env. Never commit it.
AMOCRM_BASE_URL=https://sinai24.amocrm.ru
AMOCRM_ACCESS_TOKEN=
# Long-lived amoCRM token can operate without refresh credentials.
# For OAuth2 fill all values below; rotated tokens atomically update .env.
AMOCRM_REFRESH_TOKEN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=
ADMIN_ID=8608404966
MAX_ADMIN_ID=185607445
TG_MANAGER_IDS=
MAX_MANAGER_IDS=
TG_BOT_TOKEN=
MAX_BOT_TOKEN=
TG_BOT_USERNAME=sinai_news_bot
MAX_BOT_USERNAME=
TG_WEBHOOK_SECRET=
MAX_WEBHOOK_SECRET=
AMO_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
# Docker Compose / Caddy: actual public DNS name, without https://
PUBLIC_HOST=
DATABASE_PATH=data/sinai.sqlite3
COMPLETED_PIPELINE_ID=8993570
TEST_MODE=true
BROADCASTS_ENABLED=false
CRM_NOTES_ENABLED=false
ACTIVE_INTERVAL_MONTHS=1
COMPLETED_INTERVAL_MONTHS=1
PREFERRED_PLATFORM=telegram
RECONCILIATION_SECONDS=3600
CONTACT_INDEX_SECONDS=86400
MAX_CONTACT_PAGES=1000
LINK_TTL_SECONDS=604800
# Optional verified certificate bundle, appended to system trust for MAX.
MAX_CA_BUNDLE=
LOG_LEVEL=INFO
